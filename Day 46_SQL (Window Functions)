-- Q1: Assign row numbers to employees based on salary
SELECT name, salary,
ROW_NUMBER() OVER (ORDER BY salary DESC) AS row_num
FROM employees;


-- Q2: Rank employees by salary
SELECT name, salary,
RANK() OVER (ORDER BY salary DESC) AS salary_rank
FROM employees;


-- Q3: Dense rank employees by salary
SELECT name, salary,
DENSE_RANK() OVER (ORDER BY salary DESC) AS dense_rank
FROM employees;


-- Q4: Show salary with department ranking
SELECT name, department, salary,
RANK() OVER (PARTITION BY department ORDER BY salary DESC) AS dept_rank
FROM employees;


-- Q5: Show running total of salaries
SELECT name, salary,
SUM(salary) OVER (ORDER BY salary) AS running_total
FROM employees;


-- Q6: Show average salary across all employees
SELECT name, salary,
AVG(salary) OVER () AS avg_salary
FROM employees;


-- Q7: Show highest salary in each department
SELECT name, department, salary,
MAX(salary) OVER (PARTITION BY department) AS dept_max_salary
FROM employees;


-- Q8: Show previous employee salary using LAG
SELECT name, salary,
LAG(salary) OVER (ORDER BY salary) AS previous_salary
FROM employees;


-- Q9: Show next employee salary using LEAD
SELECT name, salary,
LEAD(salary) OVER (ORDER BY salary) AS next_salary
FROM employees;


-- Q10: Find difference between current and previous salary
SELECT name, salary,
salary - LAG(salary) OVER (ORDER BY salary) AS salary_difference
FROM employees;
