-- Q1: Convert employee names to uppercase
SELECT UPPER(name) AS upper_name
FROM employees;


-- Q2: Convert employee names to lowercase
SELECT LOWER(name) AS lower_name
FROM employees;


-- Q3: Find length of employee names
SELECT name, LENGTH(name) AS name_length
FROM employees;


-- Q4: Concatenate name and department
SELECT CONCAT(name, ' - ', department) AS employee_info
FROM employees;


-- Q5: Extract first 3 characters from employee name
SELECT name, SUBSTRING(name, 1, 3) AS first_three_letters
FROM employees;


-- Q6: Find position of '@' in email
SELECT email, LOCATE('@', email) AS at_position
FROM employees;


-- Q7: Replace 'IT' with 'Technology' in department column
SELECT name, REPLACE(department, 'IT', 'Technology')


-- Q8: Remove spaces from beginning and end of employee name
SELECT TRIM(name) AS trimmed_name
FROM employees;


-- Q9: Show first letter of each employee name
SELECT name, LEFT(name, 1) AS first_letter
FROM employees;


-- Q10: Show last 2 characters of employee name
SELECT name, RIGHT(name, 2) AS last_two_characters
FROM employees;
