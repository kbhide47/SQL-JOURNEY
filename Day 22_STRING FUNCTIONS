-- =========================================
-- Day 22: SQL STRING FUNCTIONS
-- Table: employees(emp_id, name, department, designation, city)
-- =========================================


-- 1. Display employee names in UPPERCASE
SELECT UPPER(name) AS name_upper
FROM employees;


-- 2. Display employee names in lowercase
SELECT LOWER(name) AS name_lower
FROM employees;


-- 3. Display employee name and length of name
SELECT name, LENGTH(name) AS name_length
FROM employees;


-- 4. Display first 3 characters of employee name
SELECT name, SUBSTRING(name, 1, 3) AS first_three_chars
FROM employees;


-- 5. Display employee names after removing leading and trailing spaces
SELECT TRIM(name) AS trimmed_name
FROM employees;


-- 6. Replace 'a' with '@' in employee names
SELECT name, REPLACE(name, 'a', '@') AS replaced_name
FROM employees;


-- 7. Concatenate employee name and city
SELECT CONCAT(name, ' - ', city) AS name_city
FROM employees;


-- 8. Display employees whose name starts with 'A'
SELECT *
FROM employees
WHERE name LIKE 'A%';


-- 9. Display employees whose name ends with 'n'
SELECT *
FROM employees
WHERE name LIKE '%n';


-- 10. Display employees whose name contains 'ra'
SELECT *
FROM employees
WHERE name LIKE '%ra%';
