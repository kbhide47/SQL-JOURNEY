-- Q1: Create an index on department column
CREATE INDEX idx_department
ON employees(department);


-- Q2: Create a unique index on email column
CREATE UNIQUE INDEX idx_email
ON employees(email);


-- Q3: Create a composite index on department and salary
CREATE INDEX idx_dept_salary
ON employees(department, salary);


-- Q4: Retrieve employees from IT department (index helps faster search)
SELECT *
FROM employees
WHERE department = 'IT';


-- Q5: Find employee using email (fast lookup using unique index)
SELECT *
FROM employees
WHERE email = 'employee@example.com';


-- Q6: Retrieve employees from IT department with salary > 60000
SELECT *
FROM employees
WHERE department = 'IT'
AND salary > 60000;


-- Q7: Check query execution plan to see if index is used
EXPLAIN
SELECT *
FROM employees
WHERE department = 'IT';


-- Q8: Update salary for a specific employee using indexed column
UPDATE employees
SET salary = 75000
WHERE id = 101;


-- Q9: Delete employee using indexed column
DELETE FROM employees
WHERE id = 101;


-- Q10: Drop an index when it is no longer needed
DROP INDEX idx_department;
