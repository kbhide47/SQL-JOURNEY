-- Q1: Create an index on employee name
CREATE INDEX idx_employee_name
ON employees(name);


-- Q2: Create an index on email column
CREATE INDEX idx_employee_email
ON employees(email);


-- Q3: Create a unique index on email
CREATE UNIQUE INDEX idx_unique_email
ON employees(email);


-- Q4: Create a composite index on department and salary
CREATE INDEX idx_department_salary
ON employees(department, salary);


-- Q5: Show all indexes in employees table
SHOW INDEX FROM employees;


-- Q6: Drop index on name column
DROP INDEX idx_employee_name ON employees;


-- Q7: Create index for faster department search
CREATE INDEX idx_department
ON employees(department);


-- Q8: Find employees in IT department (uses index)
SELECT *
FROM employees
WHERE department = 'IT';


-- Q9: Find employee by email (uses index)
SELECT *
FROM employees
WHERE email = 'rahul@example.com';


-- Q10: Drop composite index
DROP INDEX idx_department_salary ON employees;
