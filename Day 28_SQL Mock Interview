-- =========================================
-- Day 28: SQL Mock Interview
-- Table: employees
-- Columns:
-- emp_id, name, department, salary, city, joining_date
-- =========================================


-- 1. Find the third highest salary in the company
SELECT DISTINCT salary
FROM employees
ORDER BY salary DESC
LIMIT 1 OFFSET 2;


-- 2. Find employees earning the same salary as someone else
SELECT *
FROM employees
WHERE salary IN (
    SELECT salary
    FROM employees
    GROUP BY salary
    HAVING COUNT(*) > 1
);


-- 3. Find duplicate employee names
SELECT name, COUNT(*) AS count
FROM employees
GROUP BY name
HAVING COUNT(*) > 1;


-- 4. Find employees who joined first in the company
SELECT *
FROM employees
WHERE joining_date = (
    SELECT MIN(joining_date)
    FROM employees
);


-- 5. Find department with highest average salary
SELECT department, AVG(salary) AS avg_salary
FROM employees
GROUP BY department
ORDER BY avg_salary DESC
LIMIT 1;


-- 6. Find employees who earn more than their manager
-- (Assume manager_id exists in table)
SELECT e.name AS employee_name
FROM employees e
JOIN employees m
ON e.manager_id = m.emp_id
WHERE e.salary > m.salary;


-- 7. Find running total of salaries ordered by joining_date
SELECT name, joining_date,
       SUM(salary) OVER (ORDER BY joining_date) AS running_total
FROM employees;


-- 8. Find top 2 highest paid employees in each department
SELECT *
FROM (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY department ORDER BY salary DESC) AS rn
    FROM employees
) t
WHERE rn <= 2;


-- 9. Find percentage contribution of each employee’s salary to total company salary
SELECT name, salary,
       ROUND((salary * 100.0) / SUM(salary) OVER (), 2) AS salary_percentage
FROM employees;


-- 10. Delete duplicate records keeping the lowest emp_id
DELETE FROM employees
WHERE emp_id NOT IN (
    SELECT MIN(emp_id)
    FROM employees
    GROUP BY name, department, salary, city, joining_date
);
