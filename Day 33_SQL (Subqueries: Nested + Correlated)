-- Q1: Find employees earning more than overall average salary
SELECT *
FROM employees
WHERE salary > (SELECT AVG(salary) FROM employees);


-- Q2: Find employees working in same department as 'Kasturi'
SELECT *
FROM employees
WHERE department = (
    SELECT department
    FROM employees
    WHERE name = 'Kasturi'
);


-- Q3: Find employees earning the highest salary
SELECT *
FROM employees
WHERE salary = (SELECT MAX(salary) FROM employees);


-- Q4: Find second highest salary (using subquery)
SELECT MAX(salary)
FROM employees
WHERE salary < (SELECT MAX(salary) FROM employees);


-- Q5: Find departments where average salary > 60000
SELECT department
FROM employees
GROUP BY department
HAVING AVG(salary) > 60000;


-- Q6: Find employees earning more than department average (correlated subquery)
SELECT *
FROM employees e
WHERE salary > (
    SELECT AVG(salary)
    FROM employees
    WHERE department = e.department
);


-- Q7: Find employees whose salary is equal to minimum salary of their department
SELECT *
FROM employees e
WHERE salary = (
    SELECT MIN(salary)
    FROM employees
    WHERE department = e.department
);


-- Q8: Find employees who earn more than any employee in 'HR' department
SELECT *
FROM employees
WHERE salary > ANY (
    SELECT salary
    FROM employees
    WHERE department = 'HR'
);


-- Q9: Find employees who earn more than all employees in 'HR' department
SELECT *
FROM employees
WHERE salary > ALL (
    SELECT salary
    FROM employees
    WHERE department = 'HR'
);


-- Q10: Delete employees earning below average salary
DELETE FROM employees
WHERE salary < (SELECT AVG(salary) FROM employees);
