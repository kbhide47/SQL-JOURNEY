-- Q1: Use CTE to find employees earning more than average salary
WITH avg_salary_cte AS (
    SELECT AVG(salary) AS avg_salary
    FROM employees
)
SELECT *
FROM employees
WHERE salary > (SELECT avg_salary FROM avg_salary_cte);



-- Q2: Use CTE to find department-wise average salary
WITH dept_avg AS (
    SELECT department, AVG(salary) AS avg_salary
    FROM employees
    GROUP BY department
)
SELECT *
FROM dept_avg;



-- Q3: Use CTE to find employees earning more than their department average
WITH dept_avg AS (
    SELECT department, AVG(salary) AS avg_salary
    FROM employees
    GROUP BY department
)
SELECT e.*
FROM employees e
JOIN dept_avg d
ON e.department = d.department
WHERE e.salary > d.avg_salary;



-- Q4: Use CTE to rank employees department-wise
WITH ranked_employees AS (
    SELECT *,
           RANK() OVER (PARTITION BY department ORDER BY salary DESC) AS dept_rank
    FROM employees
)
SELECT *
FROM ranked_employees;



-- Q5: Use CTE to find highest-paid employee in each department
WITH ranked_employees AS (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY department ORDER BY salary DESC) AS rn
    FROM employees
)
SELECT *
FROM ranked_employees
WHERE rn = 1;



