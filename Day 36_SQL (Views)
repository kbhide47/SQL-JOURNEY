-- Q1: Create a view to show employee name and salary
CREATE VIEW employee_salary_view AS
SELECT name, salary
FROM employees;


-- Q2: Create a view to show employees from IT department
CREATE VIEW it_employees AS
SELECT *
FROM employees
WHERE department = 'IT';


-- Q3: Display data from the view
SELECT *
FROM employee_salary_view;


-- Q4: Create a view showing employees earning more than 60000
CREATE VIEW high_salary_employees AS
SELECT name, salary
FROM employees
WHERE salary > 60000;


-- Q5: Update data using a view
UPDATE employee_salary_view
SET salary = 70000
WHERE name = 'Rahul';


-- Q6: Create a view with alias column names
CREATE VIEW emp_details AS
SELECT name AS employee_name, department AS dept
FROM employees;


-- Q7: Create a view with condition for department 'HR'
CREATE VIEW hr_employees AS
SELECT *
FROM employees
WHERE department = 'HR';


-- Q8: Drop a view
DROP VIEW hr_employees;


-- Q9: Replace an existing view
CREATE OR REPLACE VIEW employee_salary_view AS
SELECT name, salary, department
FROM employees;


-- Q10: Show employees from view with salary > 50000
SELECT *
FROM employee_salary_view
WHERE salary > 50000;
