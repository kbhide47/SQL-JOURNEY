-- =========================================
-- Day 26: Advanced SQL JOIN Scenarios
-- Tables:
-- employees(emp_id, name, department_id, manager_id, salary, city)
-- departments(department_id, department_name)
-- =========================================


-- 1. Display employee name and department name
SELECT e.name, d.department_name
FROM employees e
INNER JOIN departments d
ON e.department_id = d.department_id;


-- 2. Display employees along with their manager names (self join)
SELECT e.name AS employee_name, m.name AS manager_name
FROM employees e
LEFT JOIN employees m
ON e.manager_id = m.emp_id;


-- 3. Find employees who do not have a manager
SELECT name
FROM employees
WHERE manager_id IS NULL;


-- 4. Display department-wise total salary
SELECT d.department_name, SUM(e.salary) AS total_salary
FROM departments d
INNER JOIN employees e
ON d.department_id = e.department_id
GROUP BY d.department_name;


-- 5. Display departments with no employees
SELECT d.department_name
FROM departments d
LEFT JOIN employees e
ON d.department_id = e.department_id
WHERE e.emp_id IS NULL;


-- 6. Find employees earning more than their department’s average salary
SELECT *
FROM employees e
WHERE salary > (
    SELECT AVG(salary)
    FROM employees
    WHERE department_id = e.department_id
);


-- 7. Display employee name, department name, and city
SELECT e.name, d.department_name, e.city
FROM employees e
INNER JOIN departments d
ON e.department_id = d.department_id;


-- 8. Display employees working in departments located in multiple cities
SELECT *
FROM employees e
WHERE department_id IN (
    SELECT department_id
    FROM employees
    GROUP BY department_id
    HAVING COUNT(DISTINCT city) > 1
);


-- 9. Find the highest paid employee in each department
SELECT *
FROM employees e
WHERE salary = (
    SELECT MAX(salary)
    FROM employees
    WHERE department_id = e.department_id
);


-- 10. Display departments where average salary is greater than 50,000
SELECT d.department_name
FROM departments d
INNER JOIN employees e
ON d.department_id = e.department_id
GROUP BY d.department_name
HAVING AVG(e.salary) > 50000;
