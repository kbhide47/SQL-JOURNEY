-- =========================================
-- Day 23: Mixed SQL Interview Questions
-- Table: employees(emp_id, name, department, designation, salary, city, joining_date)
-- =========================================


-- 1. Find the second highest salary
SELECT MAX(salary) AS second_highest_salary
FROM employees
WHERE salary < (SELECT MAX(salary) FROM employees);


-- 2. Find employees earning more than average salary
SELECT *
FROM employees
WHERE salary > (SELECT AVG(salary) FROM employees);


-- 3. Display department-wise total salary
SELECT department, SUM(salary) AS total_salary
FROM employees
GROUP BY department;


-- 4. Find employees who joined after 1st Jan 2022
SELECT *
FROM employees
WHERE joining_date > '2022-01-01';


-- 5. Find the highest paid employee in each department
SELECT *
FROM employees e
WHERE salary = (
    SELECT MAX(salary)
    FROM employees
    WHERE department = e.department
);


-- 6. Display employee name and salary rank
SELECT emp_id, name, salary,
       RANK() OVER (ORDER BY salary DESC) AS salary_rank
FROM employees;


-- 7. Find departments having more than 2 employees
SELECT department, COUNT(*) AS total_employees
FROM employees
GROUP BY department
HAVING COUNT(*) > 2;


-- 8. Display employees whose name starts with 'A'
SELECT *
FROM employees
WHERE name LIKE 'A%';


-- 9. Find employee count city-wise
SELECT city, COUNT(*) AS total_employees
FROM employees
GROUP BY city;


-- 10. Display employees earning more than department average salary
SELECT *
FROM employees e
WHERE salary > (
    SELECT AVG(salary)
    FROM employees
    WHERE department = e.department
);
