-- Q1: Find the third highest salary
SELECT DISTINCT salary
FROM employees
ORDER BY salary DESC
LIMIT 1 OFFSET 2;


-- Q2: Find duplicate employee names
SELECT name, COUNT(*) AS count
FROM employees
GROUP BY name
HAVING COUNT(*) > 1;


-- Q3: Find employees earning more than the department average
SELECT name, salary, department
FROM employees e
WHERE salary > (
    SELECT AVG(salary)
    FROM employees
    WHERE department = e.department
);


-- Q4: Find employees with same salary
SELECT salary, COUNT(*) AS count
FROM employees
GROUP BY salary
HAVING COUNT(*) > 1;


-- Q5: Find employees whose salary is greater than overall average salary
SELECT *
FROM employees
WHERE salary > (
    SELECT AVG(salary)
    FROM employees
);


-- Q6: Find highest salary in each department
SELECT department, MAX(salary) AS highest_salary
FROM employees
GROUP BY department;


-- Q7: Find employees whose salary equals department maximum
SELECT name, salary, department
FROM employees e
WHERE salary = (
    SELECT MAX(salary)
    FROM employees
    WHERE department = e.department
);


-- Q8: Find employees hired in the same department as 'Rahul'
SELECT *
FROM employees
WHERE department = (
    SELECT department
    FROM employees
    WHERE name = 'Rahul'
);


-- Q9: Find employees with salary between department min and max
SELECT name, salary, department
FROM employees e
WHERE salary BETWEEN (
    SELECT MIN(salary)
    FROM employees
    WHERE department = e.department
)
AND (
    SELECT MAX(salary)
    FROM employees
    WHERE department = e.department
);


-- Q10: Find total salary expenditure of company
SELECT SUM(salary) AS total_salary
FROM employees;
